<launch>
    <node name="record3d_streamer" pkg="record3d_ros" type="record3d_ros_node.py" output="screen">
        <!-- The index of the connected Record3D device to use -->
        <param name="device_index" type="int" value="0" />

        <!-- TF Frame IDs -->
        <param name="map_frame_id" type="str" value="map" />
        <param name="camera_frame_id" type="str" value="camera_link" />

        <!-- Topic Names -->
        <param name="rgb_topic" value="/camera/rgb/image_raw" />
        <param name="depth_topic" value="/camera/depth/image_raw" />
        <param name="confidence_topic" value="/camera/confidence/image_raw" />
        <param name="camera_info_topic" value="/camera/rgb/camera_info" />
    </node>
</launch>
